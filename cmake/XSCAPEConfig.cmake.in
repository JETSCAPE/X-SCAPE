# XSCAPEConfig.cmake — CMake package configuration for X-SCAPE / JETSCAPE
# Generated by configure_package_config_file().  Do not edit manually.
#
# Downstream usage:
#
#   find_package(XSCAPE REQUIRED)
#
#   add_executable(myAnalysis analysis.cc)
#   target_link_libraries(myAnalysis PRIVATE XSCAPE::JetScape)
#
# After find_package() succeeds the following are set:
#   XSCAPE_FOUND          — TRUE
#   XSCAPE_INCLUDE_DIR    — installed header directory
#   XSCAPE_DATA_DIR       — installed share/xscape data directory
#   XSCAPE::JetScape      — imported shared-library target
#   XSCAPE::JetScapeReader— imported shared-library target (output reader)

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# ── Mandatory transitive dependencies ─────────────────────────────────────
find_dependency(Boost REQUIRED COMPONENTS filesystem program_options system)
find_dependency(HDF5  REQUIRED COMPONENTS C CXX)

# ── Import the exported XSCAPE targets ─────────────────────────────────────
include("${CMAKE_CURRENT_LIST_DIR}/XSCAPETargets.cmake")

# ── Convenience path variables ─────────────────────────────────────────────
set_and_check(XSCAPE_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(XSCAPE_DATA_DIR    "@PACKAGE_XSCAPE_DATADIR@")

check_required_components(XSCAPE)
