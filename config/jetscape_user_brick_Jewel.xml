<?xml version="1.0"?>

<!-- JEWEL as final-state shower in a static brick (T = 0.3 GeV, medium from
     t = 0.6 fm to t = 4 fm). Needs cmake -DUSE_JEWEL=ON. For the vacuum
     reference set <in_vac> 1 </in_vac>. JEWEL replaces MATTER and LBT; the
     rest of the chain is unchanged. -->

<jetscape>

  <nEvents> 100 </nEvents>

  <outputFilename>test_brick_Jewel</outputFilename>
  <JetScapeWriterAscii> on </JetScapeWriterAscii>

  <Random>
    <seed>1</seed>
  </Random>

  <!-- Hard Process -->
  <Hard>
    <PythiaGun>
      <pTHatMin>50</pTHatMin>
      <pTHatMax>60</pTHatMax>
      <eCM>5020</eCM>
    </PythiaGun>
  </Hard>

  <!-- Hydro  Module  -->
  <Hydro>
    <Brick bjorken_expansion_on="false" start_time="0.6">
      <name>Brick</name>
      <T>0.3</T>
    </Brick>
  </Hydro>

  <!--Eloss Modules -->
  <Eloss>
    <tStart> 0.6 </tStart>
    <maxT>4</maxT>
    <Jewel>
      <in_vac> 0 </in_vac>
      <keep_recoils> 1 </keep_recoils>
      <Tmax> 0.35 </Tmax>
      <lifetime> 4.0 </lifetime>
    </Jewel>
  </Eloss>

  <!-- Jet Hadronization Module -->
  <JetHadronization>
    <name>colorless</name>
  </JetHadronization>

</jetscape>
