<?xml version="1.0"?>

<!-- MATTER+LBT in a brick with the EMD holographic qhat(T) in both stages:
     MATTER QhatParametrizationType 9 (EMD qhat times the Type-5 virtuality
     factor) and LBT qhat_model 1 (EMD radiative qhat; LBT elastic scattering
     unchanged). With lambda_t = 1 the energy loss matches the default
     MATTER (Type 5) + LBT setup; lambda_t ~ 2 describes the ATLAS 0-10% jet
     R_AA at 5.02 TeV in a TRENTo + free streaming + MUSIC medium. -->

<jetscape>

  <nEvents> 50 </nEvents>

  <outputFilename>test_brick_EMD_MatterLbt</outputFilename>
  <JetScapeWriterAscii> on </JetScapeWriterAscii>

  <Random>
    <seed>1</seed>
  </Random>

  <!-- Hard Process -->
  <Hard>
    <PythiaGun>
      <pTHatMin>20</pTHatMin>
      <pTHatMax>30</pTHatMax>
      <eCM>200</eCM>
    </PythiaGun>
  </Hard>

  <!-- Hydro  Module  -->
  <Hydro>
    <Brick bjorken_expansion_on="false" start_time="0.6">
      <name>Brick</name>
      <T>0.3</T>
    </Brick>
  </Hydro>

  <!--Eloss Modules -->
  <Eloss>
    <maxT>20</maxT>
    <Matter>
      <Q0> 2.0 </Q0>
      <in_vac> 0 </in_vac>
      <vir_factor> 0.25 </vir_factor>
      <recoil_on> 0 </recoil_on>
      <brick_med> 1 </brick_med>
      <brick_length> 4 </brick_length>
      <hydro_Tc> 0.16 </hydro_Tc>
      <alphas> 0.3 </alphas>
      <QhatParametrizationType> 9 </QhatParametrizationType>
      <qhat0> 2.0 </qhat0>
      <qhatA> 10.0 </qhatA>
      <qhatB> 100.0 </qhatB>
      <lambda_t> 2.0 </lambda_t>
      <qhat_K> 1.0 </qhat_K>
    </Matter>

    <Lbt>
      <name> Lbt </name>
      <Q0> 2.0 </Q0>
      <in_vac> 0 </in_vac>
      <only_leading> 0 </only_leading>
      <hydro_Tc> 0.16 </hydro_Tc>
      <alphas> 0.3 </alphas>
      <run_alphas>1</run_alphas>
      <qhat_model> 1 </qhat_model>
      <lambda_t> 2.0 </lambda_t>
      <qhat_K> 1.0 </qhat_K>
    </Lbt>
  </Eloss>

  <!-- Jet Hadronization Module -->
  <JetHadronization>
    <name>colorless</name>
  </JetHadronization>

</jetscape>
