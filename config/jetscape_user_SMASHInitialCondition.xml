 <jetscape>

  <!-- General settings -->
  <nEvents> 1 </nEvents>
  <setReuseHydro> false </setReuseHydro>
  <nReuseHydro> 0 </nReuseHydro>
  <nEvents_printout> 1 </nEvents_printout>

  <!-- Technical settings -->
  <debug> off </debug>
  <remark> off </remark>
  <vlevel> 0 </vlevel>
  <enableAutomaticTaskListDetermination> false </enableAutomaticTaskListDetermination>

  <!--  JetScape Writer Settings -->
  <outputFilename>test_SMASH_IC</outputFilename>
  <JetScapeWriterAscii> off </JetScapeWriterAscii>
  <JetScapeWriterFinalStateHadronsAscii> on </JetScapeWriterFinalStateHadronsAscii>

  <Random>
    <seed>42</seed>
  </Random>

  <BDM>
    <Tc>0.155</Tc>
    <IC_particle_extraction_tau>0.5</IC_particle_extraction_tau>
    <!--Optional pT and momentum rapidity cuts for particles considered to go into the hydro evolution (set to 0 for no cut)-->
    <pT_cut>0</pT_cut>
    <rapidity_cut>0</rapidity_cut>
    <!--Spectator hadrons are always ignored for source terms in hydro, this switch is for the afterburner phase-->
    <ignore_spectator_hadrons>1</ignore_spectator_hadrons>
    <CreateHadronicTimeEvolutionOutput> false </CreateHadronicTimeEvolutionOutput>
  </BDM>

  <!-- Inital State Module  -->
  <IS>
    <!-- x range [-grid_max_x, grid_max_x] -->
    <!-- y range [-grid_max_y, grid_max_y]-->
    <!-- longitudinal range [-grid_max_z, grid_max_z]-->
    <!-- in units of [fm] -->
    <grid_max_x> 15 </grid_max_x>
    <grid_max_y> 15 </grid_max_y>
    <grid_max_z> 7 </grid_max_z>
    <grid_step_x> 0.2 </grid_step_x>
    <grid_step_y> 0.2 </grid_step_y>
    <grid_step_z> 0.1 </grid_step_z>

    <SMASH>
      <SMASH_config_file>../external_packages/smash/smash_config_initial_condition.yaml</SMASH_config_file>
      <SMASH_particles_file>../external_packages/smash/smash_code/input/particles.txt</SMASH_particles_file>
      <SMASH_decaymodes_file>../external_packages/smash/smash_code/input/decaymodes.txt</SMASH_decaymodes_file>

      <ProjectileProtons>79</ProjectileProtons>
      <ProjectileNeutrons>118</ProjectileNeutrons>
      <TargetProtons>79</TargetProtons>
      <TargetNeutrons>118</TargetNeutrons>

      <!-- time in fm/c in the computational frame, when the simulation should be ended -->
      <end_time>1000</end_time>
      <Sqrtsnn>200.0</Sqrtsnn>
      <FermiMotion>frozen</FermiMotion>
      <CollisionsWithinNucleus>0</CollisionsWithinNucleus>

      <Impact>
        <RandomReactionPlane>0</RandomReactionPlane>
        <!-- Pick the mode for the impact parameter -->
        <!-- Mode=0 : Value has to be set -->
        <!-- Mode=1 : Sample (uniform, quadratic) with ImpactMin, ImpactMax have to be set -->
        <Mode>1</Mode>
        <Value>0.0</Value>
        <Sample>quadratic</Sample>
        <ImpactMin>6.0</ImpactMin>
        <ImpactMax>8.0</ImpactMax>
      </Impact>
      <!--Smaller timestep here gives more accuracy in the iso-tau hypersurface extraction-->
      <Delta_Time>0.002</Delta_Time>
    </SMASH>
  </IS>

  <Liquefier>
    <HadronicLiquefier>
        <name>HadronicLiquefier</name>
        <covariant_kernel>1</covariant_kernel> <!-- 0: use Gaussian kernel, 1: use covariant kernel -->
        <sigma_transverse>0.5</sigma_transverse> <!-- smearing width in transverse direction -->
        <sigma_longitudinal>0.5</sigma_longitudinal> <!-- smearing width in longitudinal direction (only for Gaussian kernel) -->
    </HadronicLiquefier>
  </Liquefier>

  <!-- Hydro  Module  -->
  <Hydro>

    <CartesianHydro> false </CartesianHydro>

    <!-- MUSIC  -->
    <MUSIC>
      <name>MUSIC</name>
      <MUSIC_input_file>music_input</MUSIC_input_file>
      <InitialProfile>43</InitialProfile>
      <beastMode>0</beastMode>
      <Initial_time_tau_0>0.5</Initial_time_tau_0>
      <EOS>20</EOS>

      <!--evolution output/storage parameters-->
      <output_evolution_to_file>0</output_evolution_to_file><!--2 for movie output-->
      <output_evolution_to_memory>0</output_evolution_to_memory>
      <!--When there is a pre-equilibrium stage, and it is kept in memory, this has to be 1-->
      <output_evolution_every_N_timesteps>10</output_evolution_every_N_timesteps>
      <surface_in_memory>1</surface_in_memory>

      <T_dependent_Shear_to_S_ratio>3</T_dependent_Shear_to_S_ratio>
      <shear_viscosity_3_T_kink_in_GeV>0.16</shear_viscosity_3_T_kink_in_GeV>
      <shear_viscosity_3_at_kink>0.08</shear_viscosity_3_at_kink>
      <shear_viscosity_3_low_T_slope_in_GeV>0</shear_viscosity_3_low_T_slope_in_GeV>
      <shear_viscosity_3_high_T_slope_in_GeV>0</shear_viscosity_3_high_T_slope_in_GeV>

      <temperature_dependent_bulk_viscosity>10</temperature_dependent_bulk_viscosity>
      <bulk_viscosity_10_max>0.10</bulk_viscosity_10_max>
      <!-- The following two parameters are set automatically to bulk_viscosity_10_max and (max+max_muB0p4)/2. if the values are -1 here-->
      <bulk_viscosity_10_max_muB0p4>-1</bulk_viscosity_10_max_muB0p4>
      <bulk_viscosity_10_max_muB0p2>-1</bulk_viscosity_10_max_muB0p2>
      <bulk_viscosity_10_width_high>0.08</bulk_viscosity_10_width_high>
      <bulk_viscosity_10_width_low>0.010</bulk_viscosity_10_width_low>
      <bulk_viscosity_10_T_peak>0.17</bulk_viscosity_10_T_peak>
      <bulk_viscosity_10_T_peak_muBcurv>-0.15</bulk_viscosity_10_T_peak_muBcurv>

      <muB_dependent_Shear_to_S_ratio>10</muB_dependent_Shear_to_S_ratio>
      <shear_10_muBDep_alpha>0.7</shear_10_muBDep_alpha>
      <shear_10_muBDep_slope>2.0</shear_10_muBDep_slope>
      <shear_10_muBDep_scale>0.6</shear_10_muBDep_scale>

      <Include_second_order_terms>1</Include_second_order_terms>
      <Include_Rhob>1</Include_Rhob>
      <Include_QS>1</Include_QS>

      <use_eps_for_freeze_out>1</use_eps_for_freeze_out>
      <eps_switch>0.35</eps_switch>

      <Perform_CooperFrye_Freezeout>0</Perform_CooperFrye_Freezeout>
    </MUSIC>

  </Hydro>

  <!-- Particlization Module  -->
  <SoftParticlization>
    <!-- iSpectraSampler -->
    <iSS>
      <!-- read in file type  -->
      <!-- hydro_mode == 0 read in surface file from VISHNew -->
      <!-- hydro_mode == 1 read in surface file from MUSIC (2+1)D -->
      <!-- hydro_mode == 2 read in surface file from MUSIC (3+1)D -->
      <hydro_mode>2</hydro_mode>

      <!-- file path for the default input file  -->
      <iSS_input_file>../external_packages/iSS/iSS_parameters.dat</iSS_input_file>
      <!-- directory path where the hydro surface is stored  -->
      <iSS_working_path>.</iSS_working_path>
      <!-- file path for the default table files  -->
      <iSS_table_path>../external_packages/iSS/iSS_tables</iSS_table_path>
      <!-- file path for the default particle table files  -->
      <iSS_particle_table_path>../external_packages/iSS/iSS_tables</iSS_particle_table_path>
      <!-- hadron species list  0: PDG 2005; 1: UrQMD; 2: SMASH -->
      <afterburner_type>2</afterburner_type>

      <deltaf_type>20</deltaf_type>
      <include_deltaf_shear>1</include_deltaf_shear>
      <include_deltaf_bulk>1</include_deltaf_bulk>

      <number_of_repeated_sampling>1</number_of_repeated_sampling>
      <Perform_resonance_decays>0</Perform_resonance_decays>
    </iSS>
  </SoftParticlization>

  <!-- Hadronic Afterburner  -->
  <Afterburner>
    <!-- fragmentation hadrons in the afterburner only possible with hybrid hadronization-->
    <include_fragmentation_hadrons>0</include_fragmentation_hadrons>
    <!-- only the afterburner hadrons are written to a file -->
    <!-- if fragmentation hadrons are not included in the afterburner they are also written  -->
    <output_only_final_state_hadrons>1</output_only_final_state_hadrons>
    <!-- SMASH -->
    <SMASH>
      <name>SMASH</name>
      <SMASH_config_file>../external_packages/smash/smash_config.yaml</SMASH_config_file>
      <SMASH_particles_file>../external_packages/smash/smash_code/input/particles.txt</SMASH_particles_file>
      <SMASH_decaymodes_file>../external_packages/smash/smash_code/input/decaymodes.txt</SMASH_decaymodes_file>
      <!-- time in fm/c in the computational frame, when the simulation shoud be ended -->
      <end_time>1000.0</end_time>
      <!-- 0 - run the full afterburner, 1 - only decay the resonances without even propagation -->
      <only_decays>0</only_decays>
    </SMASH>
  </Afterburner>

 </jetscape>